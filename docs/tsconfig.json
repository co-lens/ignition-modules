// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    // src/data/tools.json is imported directly by the ToolReference component and checked against
    // src/types/tools.ts, so a change to the generator's output shape fails `npm run typecheck`.
    "resolveJsonModule": true
  },
  "exclude": [".docusaurus", "build"]
}
